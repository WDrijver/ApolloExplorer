<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- acp/ash link against Qt frameworks outside the bundle (e.g. Homebrew),
	     which are not signed by our Team ID. The hardened runtime would refuse
	     to load them without this entitlement. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
